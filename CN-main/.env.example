# Gemini API Keys (comma separated/numbered or single fallback)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY=your_fallback_api_key

# Django Production & Dev Configuration
DJANGO_SECRET_KEY=generate-a-strong-random-key-for-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Production Security overrides (Set to True in production with HTTPS)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False


